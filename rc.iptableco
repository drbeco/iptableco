#! /bin/sh
### BEGIN INIT INFO
# Provides:          rc.iptableco
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: iptables management toolkit (v3 -- chain-based architecture)
# Description:       Manages iptables rules organized in user-defined chains
#                    (IPTABLECO-INPUT, IPTABLECO-OUTPUT). The rules file at
#                    /etc/iptableco/iptables.rules is the source of truth.
#                    Per-host config (variables) at /etc/iptableco/iptables.env.
#
#   help     : shows this help
#   start    : applies our rules (idempotent; preserves other user chains)
#   stop     : removes only our rules and policies; other user chains preserved
#   restart  : stop + start
#   status   : show our chains with rule counters (--force shows full state)
#   panic    : drop all traffic except loopback + maintainer SSH
#   flush    : full nuke -- ACCEPT all, delete all user chains (ours and others)
#   install  : fresh install, creates /etc/iptableco/ + skeleton iptables.rules + iptables.env (--force overwrites)
#   backup   : snapshot kernel state to /etc/iptableco/<timestamp>-iptables-bkp.rules
#   restore  : apply a specific backup file to the kernel
#
### END INIT INFO
#
# Author:  Ruben Carlo Benante <rcb@beco.cc>
# Launch:  2016-05-26
# v3:      2026-06-03 -- chain-based architecture
# v3.1:    2026-06-04 -- status shows FORWARD + v6 nat
# VERSION="3.1.20260604"
#
# #########################################################################

# Bash options:
#    set -e : exit shell on errors
#    set -u : treat undefined variables as errors
set -eu

# #########################################################################
# Handle error function
#
handle_error()
{
    echo "iptables-error : iptableco handling unknown error"
    echo "iptables-error : iptableco handling unknown error" >> /var/log/messages
    exit 1
}
trap "handle_error" ERR


# #########################################################################
# Global config vars
#
VERSION="3.1.20260604"
DDATE=$(date +"%Y%m%d%H%M%S")
PATH=/sbin:/usr/sbin:/bin:/usr/bin
ENVFILE=/etc/iptableco/iptables.env
MAINRULES=/etc/iptableco/iptables.rules
BACKUPDIR=/etc/iptableco/

# IPV4 bin
IPT=/usr/sbin/iptables
IPTS=/usr/sbin/iptables-save
IPTR=/usr/sbin/iptables-restore

# IPV6 bin
IP6T=/usr/sbin/ip6tables
IP6TS=/usr/sbin/ip6tables-save
IP6TR=/usr/sbin/ip6tables-restore

# #########################################################################
# bootstrap /etc/iptableco/ on a fresh host (idempotent: never overwrites)
#
iptableco_install()
{
    f="${1:-no}"   # "yes" if --force was passed; default "no"
    mkdir -p /etc/iptableco

    # Minimal iptables.rules with chain scaffolding + ACCEPT policies
    if [ ! -f "$MAINRULES" ] || [ "$f" = "yes" ] ; then
cat <<- EOF > $MAINRULES
# Generated by rc.iptableco install version $VERSION on $DDATE
# Minimal iptables.rules -- replace with real rules.
# Policies are ACCEPT so nothing locks out until the file is filled in.
*filter
:INPUT   ACCEPT [0:0]
:OUTPUT  ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:IPTABLECO-INPUT  - [0:0]
:IPTABLECO-OUTPUT - [0:0]
-A INPUT  -j IPTABLECO-INPUT
-A OUTPUT -j IPTABLECO-OUTPUT
COMMIT
EOF
        echo "Created (or overwrote) $MAINRULES"
    else
        echo "$MAINRULES already exists -- not overwritten (use --force)"
    fi

    # Generic skeleton iptables.env (EDIT before start)
    if [ ! -f "$ENVFILE" ] || [ "$f" = "yes" ] ; then
cat <<- EOF > $ENVFILE
# Generated by rc.iptableco install version $VERSION on $DDATE
# Per-host iptableco configuration. EDIT before running 'start'.

# Network interfaces
PUBIF=""
INTIF=""

# Local host
THISHOST=""

# Network gateway
GATEWAY=""

# Trusted peers
MAINIP=""        # maintainer SSH peer (used by 'panic')

# Local devices
PRINTER=""

# ICMP type aliases (constants, no edit needed)
PING="echo-request"
PONG="echo-reply"
EOF
        echo "Created (or overwrote) $ENVFILE -- EDIT before running 'start'"
    else
        echo "$ENVFILE already exists -- not overwritten (use --force)"
    fi
}

# #########################################################################
# test required files exist (optional test also backup)
#
files_exist()
{
    if [ "y${1:-}" != "y" ] ; then
        if [ ! -f "$1" ]; then
            echo "File $1 does not exist"
            echo "If it is a restore, try first /etc/rc.d/rc.iptableco backup"
            exit 1
        fi
    fi
    if [ ! -f "$MAINRULES" ]; then
        echo "Unable to start iptables firewall - $MAINRULES does not exist"
        echo "Try first /etc/rc.d/rc.iptableco install"
        exit 1
    fi
    if [ ! -f "$ENVFILE" ]; then
        echo "Unable to start iptables firewall - $ENVFILE does not exist"
        echo "Try first /etc/rc.d/rc.iptableco install"
        exit 1
    fi
    if [ ! -f "$IPT" ]; then
        echo "Cannot find $IPT for IPV4"
        exit 1
    fi
    if [ ! -f "$IP6T" ]; then
        echo "Cannot find $IP6T for IPV6"
        exit 1
    fi
}

# #########################################################################
# main script start:
#
commands=" help start stop restart status panic flush install backup restore "
comm="err"
force="no"
arg=""           # raw 2nd positional arg (--force or backup filename)
BKPRULES=""      # backup file path (set by validation if restore)
if [ $# -eq 1 ] ; then
    case "$commands" in
        *" $1 "*)
            comm="$1"
            ;;
    esac
fi
if [ $# -eq 2 ] ; then
    case "$commands" in
        *" $1 "*)
            comm="$1"
            arg="$2"
            ;;
        *" $2 "*)
            comm="$2"
            arg="$1"
            ;;
    esac
fi
if [ "y$arg" = "y--force" ] ; then
    force="yes"
    arg=""
fi
if [ "$comm" = "restore" ] ; then
    if [ -z "$arg" ] ; then
        echo "usage: restore <backup-file>"
        exit 1
    fi
    BKPRULES="$arg"
    arg=""
elif [ -n "$arg" ] ; then
    comm="err"
    arg=""
fi
if [ "$comm" = "err" ] ; then
    echo "Error: Please provide a valid command:"
    echo "       [help|start|stop|restart|status [--force]|panic|flush|install [--force]|backup|restore <file>]"
    echo
    echo "For more info, try:"
    echo "       ${0} help"
    echo
    exit 1
fi

# check if ready for all cases except install/help
case "$comm" in
    install|help) : ;;
    *) files_exist "$BKPRULES" ;;
esac

case "$comm" in
    'start') # start: need MAINRULES + ENVFILE
        echo "Setting up iptables firewall..."
        set -a ; . $ENVFILE ; set +a # read config variables to environment
        echo "Applying main rules..."
        envsubst < $MAINRULES | $IPTR  -n
        envsubst < $MAINRULES | $IP6TR -n
        echo "Start done for IPV4 and IPV6."
        exit 0
        ;;
    'stop') # stop: needs no files; removes only our own footprint
        echo "Stopping iptableco rules..."
        # Reset policies + remove our user chains (IPv4 and IPv6)
        for c in INPUT OUTPUT FORWARD POSTROUTING ; do
            if [ "$c" = "POSTROUTING" ] ; then
                t="-t nat"
            else
                t=""
                $IPT  -P $c ACCEPT                               # reset built-in policy IPv4
                $IP6T -P $c ACCEPT                               # reset built-in policy IPv6
            fi
            $IPT  $t -D $c -j IPTABLECO-$c 2>/dev/null || true   # remove jump  IPv4
            $IPT  $t -F IPTABLECO-$c       2>/dev/null || true   # flush rules  IPv4
            $IPT  $t -X IPTABLECO-$c       2>/dev/null || true   # delete chain IPv4
            $IP6T $t -D $c -j IPTABLECO-$c 2>/dev/null || true   # remove jump  IPv6
            $IP6T $t -F IPTABLECO-$c       2>/dev/null || true   # flush rules  IPv6
            $IP6T $t -X IPTABLECO-$c       2>/dev/null || true   # delete chain IPv6
        done
        echo "Stop done. iptableco footprint removed; other user chains preserved."
        exit 0
        ;;
    'restart') # restart: need MAINRULES + ENVFILE
        echo "Restarting iptables firewall..."
        ${0} stop
        sleep 1
        ${0} start
        echo "Restart done for IPV4 and IPV6."
        exit 0
        ;;
    'status') # status: show our chains; --force shows full state too
        if [ "$force" = "yes" ] ; then
            echo "Full iptables state for IPV4......................................................."
            $IPT  -L -n -v --line-number
            $IPT  -t nat -L -n -v --line-number
            echo
            echo "Full iptables state for IPV6......................................................."
            $IP6T -L -n -v --line-number
        else
            echo "IPTABLECO chains for IPV4........................................................."
            for c in INPUT OUTPUT FORWARD ; do
                $IPT  -L IPTABLECO-$c -n -v --line-number 2>/dev/null || echo "  (IPTABLECO-$c not present)"
            done
            $IPT  -t nat -L IPTABLECO-POSTROUTING -n -v --line-number 2>/dev/null || echo "  (IPTABLECO-POSTROUTING not present)"
            echo
            echo "IPTABLECO chains for IPV6........................................................."
            for c in INPUT OUTPUT FORWARD ; do
                $IP6T -L IPTABLECO-$c -n -v --line-number 2>/dev/null || echo "  (IPTABLECO-$c not present)"
            done
            $IP6T -t nat -L IPTABLECO-POSTROUTING -n -v --line-number 2>/dev/null || echo "  (IPTABLECO-POSTROUTING not present)"
        fi
        echo
        exit 0
        ;;
    'panic') # panic: lock down + accept loopback + maintainer SSH only
        set -a ; . $ENVFILE ; set +a # read config variables to environment ($MAINIP)
        echo "Closing all ports except localhost and maintainer SSH..."
        # IPV4 rules -----------------------------------------------------
        # Clear only tables that do exist, set policy to DROP
        $IPTS | awk '/^[*]/ { print $1 } /^:[ADEFGINOPRSTUW]+ [^-]/ { print $1 " DROP" ; } /COMMIT/ { print $0; }' | $IPTR
        $IPT -X                 # delete user-defined chains
        $IPT -Z                 # reset package counters
        # Don't drop INPUT/OUTPUT on localhost
        $IPT -4 -A INPUT -i lo -j ACCEPT
        $IPT -4 -A OUTPUT -o lo -j ACCEPT
        # Accept SSH from Maintainer Notebook
        $IPT -4 -A INPUT -p tcp -s $MAINIP --dport 22 -m state --state NEW,ESTABLISHED -j ACCEPT
        $IPT -4 -A OUTPUT -p tcp -d $MAINIP --sport 22 -m state --state ESTABLISHED -j ACCEPT
        # IPV6 rules -----------------------------------------------------
        # Clear only tables that do exist, set policy to DROP
        $IP6TS | awk '/^[*]/ { print $1 } /^:[ADEFGINOPRSTUW]+ [^-]/ { print $1 " DROP" ; } /COMMIT/ { print $0; }' | $IP6TR
        $IP6T -X                # delete user-defined chains
        $IP6T -Z                # reset package counters
        # Don't drop INPUT/OUTPUT on localhost
        $IP6T -6 -A INPUT -i lo -j ACCEPT
        $IP6T -6 -A OUTPUT -o lo -j ACCEPT
        echo "Panic mode ON for IPV4 and IPV6."
        exit 0
        ;;
    'flush') # flush: full nuke -- ACCEPT all + delete all user chains (ours and others)
        echo "Flushing all iptables rules and user chains..."
        # IPV4 rules -----------------------------------------------------
        # Set every built-in chain policy to ACCEPT, drop all rules
        $IPTS | awk '/^[*]/ { print $1 } /^:[ADEFGINOPRSTUW]+ [^-]/ { print $1 " ACCEPT" ; } /COMMIT/ { print $0; }' | $IPTR
        $IPT -X                 # delete user-defined chains (ours + any others)
        $IPT -Z                 # reset packet counters
        # IPV6 rules -----------------------------------------------------
        $IP6TS | awk '/^[*]/ { print $1 } /^:[ADEFGINOPRSTUW]+ [^-]/ { print $1 " ACCEPT" ; } /COMMIT/ { print $0; }' | $IP6TR
        $IP6T -X                # delete user-defined chains
        $IP6T -Z                # reset packet counters
        echo "Flush done. All ports open for IPV4 and IPV6. User chains from other tools will need to be recreated."
        exit 0
        ;;
    'backup') # backup: snapshot kernel state into a single unified .rules file
        BKPRULES="${BACKUPDIR}${DDATE}-iptables-bkp.rules"
        echo "Backing up rules to $BKPRULES..."
        : > $BKPRULES   # truncate (or create if missing)
        # Per table: iptables-save first (full -- headers + chains + rules),
        # then ip6tables-save (rules only; headers/chains come from v4 dump).
        # Every -A line is tagged -4 or -6 for family identification.
        for t in nat filter ; do
            $IPTS  -t $t | grep -Ev "^COMMIT$"         | sed "s/^-A /-4 -A /" >> $BKPRULES
            $IP6TS -t $t | grep -Ev "^(\*$t|:[^ ]+ )"  | sed "s/^-A /-6 -A /" >> $BKPRULES
        done
        # NOTE: raw, mangle, security tables not included; extend the loop if needed.
        echo "Backup done: $BKPRULES"
        exit 0
        ;;
    'restore') # needs BKPRULES, MAINRULES
        #TODO: if [ ! -f $BKPRULES ] : restore the most recent backup by date
        echo "Restoring... $BKPRULES"
        cp -i $BKPRULES $MAINRULES # /etc/iptableco/iptables.rules
        ${0} restart
        echo "Restore done for IPV4 and IPV6."
        exit 0
        ;;
    'install') # install: bootstrap /etc/iptableco/ (idempotent unless --force)
        echo "Installing iptableco at /etc/iptableco/ ..."
        iptableco_install "$force"
        echo "Installation done. Use /etc/rc.d/rc.iptableco start to activate the firewall"
        exit 0
        ;;
    *) # help: needs no files
        echo
        echo "Help for rc.iptableco by drbeco version $VERSION"
        echo
        echo "  Usage: $0  {help|start|stop|restart|status|panic|flush|install|backup|restore <file>} [--force]"
        echo
        echo "  help     : shows this help"
        echo "  start    : applies our rules (idempotent; preserves other user chains)"
        echo "  stop     : removes only our rules and policies; other user chains preserved"
        echo "  restart  : stop + start"
        echo "  status   : show our chains with rule counters (--force shows full state)"
        echo "  panic    : drop all traffic except loopback + maintainer SSH"
        echo "  flush    : full nuke -- ACCEPT all, delete all user chains (ours and others)"
        echo "  install  : fresh install, creates /etc/iptableco/ + skeleton iptables.rules + iptables.env (--force overwrites existing)"
        echo "  backup   : snapshot kernel state to /etc/iptableco/<timestamp>-iptables-bkp.rules"
        echo "  restore  : apply a specific backup file to the kernel"
        echo
        exit 1
        ;;
esac

exit 0

# vi: set ai et ts=4 sw=4 tw=0 wm=0
# end of /etc/rc.d/rc.iptableco script by drbeco

